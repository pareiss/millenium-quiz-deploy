#!/usr/bin/env bash
# Encrypted secrets per overlay (SOPS + age).
#
#   overlays/<overlay>/secrets.enc.env  committed, encrypted
#   overlays/<overlay>/secrets.env      gitignored plaintext that kustomize reads
#
# Usage: bin/secrets encrypt|decrypt|edit|updatekeys [overlay]   (default: local)
# Needs `sops` and the age key in ~/.config/sops/age/keys.txt (or SOPS_AGE_KEY_FILE).
set -euo pipefail

cmd=${1:-}
overlay=${2:-local}
dir="$(cd "$(dirname "$0")/.." && pwd)/overlays/$overlay"
plain="$dir/secrets.env"
enc="$dir/secrets.enc.env"
fmt=(--input-type dotenv --output-type dotenv)

[ -d "$dir" ] || { echo "no overlay: $dir" >&2; exit 1; }
cd "$(dirname "$0")/.."

case "$cmd" in
  encrypt)
    [ -f "$plain" ] || { echo "missing $plain" >&2; exit 1; }
    sops encrypt "${fmt[@]}" --filename-override "$enc" "$plain" > "$enc.tmp"
    mv "$enc.tmp" "$enc"
    echo "encrypted -> ${enc#"$PWD"/}"
    ;;
  decrypt)
    (umask 077; sops decrypt "${fmt[@]}" "$enc" > "$plain.tmp")
    mv "$plain.tmp" "$plain"
    echo "decrypted -> ${plain#"$PWD"/} (gitignored)"
    ;;
  edit)
    sops edit "$enc"
    "$0" decrypt "$overlay"
    ;;
  updatekeys)
    sops updatekeys "$enc"
    ;;
  *)
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
