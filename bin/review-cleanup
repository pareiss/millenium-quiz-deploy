#!/usr/bin/env bash
# Moves the reviews of pull requests that are no longer open (merged or
# closed) from reviews/ to reviews/archive/, so reviews/ only lists PRs that
# still need attention. Archived, not deleted: the verdicts ticked in them
# stay available. Their logs (reviews/logs/) are deleted.
#
#   bin/review-cleanup
#
# bin/review-deploy-open-prs runs this first. Reviews whose PR state can't be read
# (gh not logged in, no network, rate limit) are left in place with a warning,
# and the summary counts them, so "0 archived" never hides a failed check.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"
# gh may only talk to this repository (the origin remote).
GH_REPO="$(bin/review-tools repo)"
export GH_REPO
reviews="$(bin/review-dir)"
shopt -s nullglob

moved=0
unchecked=0
for file in "$reviews"/pr-*.md; do
  number="$(sed -n 's/^- PR: #\([0-9]*\).*/\1/p' "$file" | head -1)"
  if [[ -z "$number" ]]; then
    echo "review cleanup: skipped $file: no \"- PR: #<number>\" line in its header" >&2
    unchecked=$((unchecked + 1))
    continue
  fi
  if ! state="$(gh pr view "$number" --json state --jq .state 2>&1)"; then
    echo "review cleanup: skipped $file: could not read the state of PR #$number: $state" >&2
    unchecked=$((unchecked + 1))
    continue
  fi
  [[ "$state" == OPEN ]] && continue

  name="$(basename "$file" .md)"
  head="$(sed -n 's/^- Head: `\([0-9a-f]\{7\}\).*/\1/p' "$file" | head -1)"
  mkdir -p "$reviews/archive"
  dest="$reviews/archive/${name}-${head:-unknown}-$(tr '[:upper:]' '[:lower:]' <<<"$state").md"
  [[ -e "$dest" ]] && dest="${dest%.md}-$(date -u +%Y%m%dT%H%M%S).md"
  mv "$file" "$dest"
  rm -f "$reviews/logs/${name}.log"
  echo "archived #$number ($state): $file -> $dest"
  moved=$((moved + 1))
done

echo "review cleanup: $moved review(s) of merged or closed PRs archived$(
  [[ $unchecked -gt 0 ]] && echo ", $unchecked could not be checked (see warnings above)")"
