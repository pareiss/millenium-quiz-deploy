# cp secrets.env.example secrets.env  (secrets.env is gitignored)
# Generate values with:  openssl rand -hex 24   /   openssl rand -base64 48
# Use hex for POSTGRES_PASSWORD so it can go into DATABASE_URL unescaped.

POSTGRES_PASSWORD=change-me-hex
DATABASE_URL=ecto://millennium_quiz:change-me-hex@postgres/millennium_quiz

SECRET_KEY_BASE=change-me-64-plus-characters-change-me-64-plus-characters-change-me
# Erlang distribution cookie (only relevant once the app is clustered)
RELEASE_COOKIE=change-me-cookie

# First admin, created by the migrate init container if no admin exists yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-at-least-12-chars

# Optional: send resume links by email (otherwise they are only logged)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=quiz@example.com
